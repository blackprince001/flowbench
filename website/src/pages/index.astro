---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ProofRail from "../components/ProofRail.astro";
import ProductStage from "../components/ProductStage.astro";
import FastFacts from "../components/FastFacts.astro";
import Features from "../components/Features.astro";
import Workflow from "../components/Workflow.astro";
import DecisionTable from "../components/DecisionTable.astro";
import InstallCard from "../components/InstallCard.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout>
  <Hero />
  <ProofRail />
  <ProductStage />
  <FastFacts />
  <Features />
  <Workflow />
  <DecisionTable />
  <InstallCard />
  <Faq />
  <FinalCta />
  <SiteFooter slot="footer" />
</BaseLayout>
