---
import SiteHeader from "../components/SiteHeader.astro";
import { SITE } from "../content/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0c0a09" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- The sans carries the headline; preloading it keeps the hero from
         reflowing on first paint. -->
    <link
      rel="preload"
      href="/fonts/OpenRunde-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Set before first paint: enhanced components (the product switcher)
         collapse to one view, and stay fully stacked when this never runs. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
