---
// Three statements under the stage, each closing one loop the product window
// opened: one flow, one engine, one vocabulary.
const FACTS = [
  {
    title: "One canonical flow.",
    body: "Author in YAML or Python. Both resolve to the same model, so neither is a second-class port of the other.",
  },
  {
    title: "One measured engine.",
    body: "Go, a goroutine per VU, explicit safety ceilings — and a published footprint rather than a claim.",
  },
  {
    title: "One span vocabulary.",
    body: "Dashboard, flame graph and waterfall agree because they are three readings of the same spans.",
  },
];
---

<section class="facts" aria-label="How Flowbench is built">
  <div class="shell">
    <ul>
      {
        FACTS.map((fact) => (
          <li>
            <h3>{fact.title}</h3>
            <p>{fact.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .facts {
    padding-block: clamp(3rem, 7vw, 4.5rem);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  h3 {
    font-size: 1.0625rem;
    font-weight: 500;
  }

  p {
    margin-top: 0.5rem;
    color: var(--ink-3);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  @media (max-width: 800px) {
    ul {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }
  }
</style>
